[Unit]
Description=DevForge News Collector
After=network-online.target postgres.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/workspace/minihome/apps/news
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3.12 -u /opt/workspace/minihome/apps/news/collector.py --limit 3 --keys OPENROUTER-*,GEMINI-*,BRAVE-*,EXA-*,TAVILY-*,YOUCOM-*,CONTEXT7-*,TELEGRAM-*,GMAIL-*
TimeoutStartSec=3600
Environment=HOME=/home/opc
Environment=PYTHONPATH=/opt/projects/server/scripts:/opt/workspace/minihome/apps/news
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
