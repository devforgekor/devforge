# Escalation Router Environment Variables
# Copy to .env and fill in your keys

# OpenRouter API Keys (3+ for round-robin free tier)
# Get from https://openrouter.ai/keys
OPENROUTER_KEY_1=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_KEY_2=sk-or-v1-yyyyyyyyyyyyyyyyyyyyyyyy
OPENROUTER_KEY_3=sk-or-v1-zzzzzzzzzzzzzzzzzzzzzzzz

# DeepSeek API Key (fallback tier)
# Get from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# opencode Go Subscription Server
# Run: opencode serve --port 4096 --auth basic:user:pass
OPENCODE_AUTH_USER=user
OPENCODE_AUTH_PASS=your-secure-password
OPENCODE_BASE_URL=http://127.0.0.1:4096/v1

# Optional: Custom DeepSeek base URL (default: https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: Custom OpenRouter base (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenRouter site/app identification
YOUR_SITE_URL=https://your-domain.com
YOUR_APP_NAME=DevForge Extraction Pipeline