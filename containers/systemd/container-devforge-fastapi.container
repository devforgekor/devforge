[Unit]
# [WHY] RestartSec>=10 이면 기본 StartLimitIntervalSec(10s) 윈도우가 채워지지 않아
#       start limit이 영영 trip되지 않고 auto-restart 루프가 무한 지속된다
#       (2026-10-03 devforge-mcp 4시간 1141회 재시도, watchdog 무감지).
#       systemd.unit(5) 참조. [Unit] 섹션이어야 systemd가 인식한다.
StartLimitIntervalSec=60
Description=DevForge FastAPI — Slack + Telegram + Email (:8002)
After=svc.pod

[Container]
ContainerName=devforge-fastapi
Image=localhost/devforge-fastapi:latest
Pull=never
Pod=svc.pod
Entrypoint=/bin/bash
Exec=/scripts/fastapi-entrypoint.sh
Volume=/opt/projects/server/scripts:/scripts:Z
Volume=/opt/ai_data/search:/opt/ai_data/search:Z
Volume=/home/opc/.oci:/root/.oci:ro,Z
Volume=/home/opc/.config/devforge:/root/.config/devforge:ro,Z
Environment=DEVFORGE_DB_TCP=1
Environment=BLOB_EXPLORER_LISTEN=0.0.0.0:8085

HealthCmd=/bin/bash -c 'curl -sf http://127.0.0.1:8002/health || exit 1'
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=restart

[Service]
Restart=always
RestartSec=10
#       interval을 RestartSec보다 크게 두면 루프가 failed로 전이되어 감지된다.
TimeoutStopSec=30

[Install]
WantedBy=default.target
