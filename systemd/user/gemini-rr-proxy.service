[Unit]
Description=Gemini OpenAI-Compatible Key Round-Robin Proxy
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3.12 /opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3.12 /opt/projects/server/scripts/proxies/gemini_rr_proxy.py --keys GEMINI-API-KEYS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
