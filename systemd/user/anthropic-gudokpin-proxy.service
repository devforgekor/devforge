[Unit]
Description=Anthropic→Gudokpin Format Conversion Proxy
Documentation=https://api.gudokpin.com
After=network.target

[Service]
Type=simple
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3 -u /opt/projects/server/scripts/proxies/anthropic_gudokpin.py --keys GUDOKPIN-*,DEEPSEEK-*
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
