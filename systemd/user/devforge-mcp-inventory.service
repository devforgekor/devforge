[Unit]
Description=DevForge MCP Inventory — shadow MCP drift check (OWASP MCP09)
OnFailure=devforge-mcp-inventory-failed.service

[Service]
Type=oneshot
WorkingDirectory=/opt/projects/server
ExecStart=/usr/bin/python3.12 /opt/projects/server/scripts/mcp_inventory_check.py
StandardOutput=journal
StandardError=journal
