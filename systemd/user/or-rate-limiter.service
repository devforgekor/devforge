[Unit]
Description=OpenRouter rate-limiting proxy (15 RPM)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3.12 /opt/projects/server/scripts/or_rate_limiter.py --keys OPENROUTER-*
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
