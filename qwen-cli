 ██║▄▄ ██║██║███╗██║██╔══╝  ██║╚██╗██║
 ╚██████╔╝╚███╔███╔╝███████╗██║ ╚████║
  ╚══▀▀═╝  ╚══╝╚══╝ ╚══════╝╚═╝  ╚═══╝
  Tongyi Qianwen
"""


def show_splash() -> None:
    print(SPLASH)
    print(f"  model : {MODEL}")
    print(f"  endpoint : {ENDPOINT}")
    print()


def show_help() -> None:
    print("명령어:")
    print("  /exit, /quit  — 종료")
    print("  /clear        — 대화 내용 초기화")
    print("  /heavy        — 다음 질문만 heavy (1회성, 4096토큰)")
    print("  /heavy on     — 항상 heavy 모드 (light로 복귀할 때까지)")
    print("  /light        — light 모드로 복귀")
    print("  /help         — 도움말")


def main() -> None:
    load_history()

    messages: list[dict] = [{"role": "system", "content": SYSTEM_PROMPT}]
    max_tokens = LIGHT_MAX_TOKENS
    one_shot_heavy = False
    persistent_heavy = False
    auto_heavy = False

    show_splash()
    print("KV 캐시 워밍업 중...", end=" ", flush=True)
    _warmup_cache()
    print("완료")

    keepalive = threading.Thread(target=_keepalive_loop, daemon=True)
    keepalive.start()

    print("대화를 시작하세요. 종료하려면 /exit 또는 Ctrl+C를 입력하세요.")
    print("질문을 분석해 자동으로 light/heavy 모드를 선택합니다.\n")

    while True:
        if persistent_heavy:
            label = "heavy"
        elif one_shot_heavy:
            label = "heavy*"
        elif auto_heavy:
            label = "light>heavy"
        else:
            label = "light"
        try:
            user_input = input(f"[{label}] > ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n종료합니다.")
            _keepalive_stop.set()
            break

        if not user_input:
            continue

        if user_input in CMDS:
            if user_input in ("/exit", "/quit"):
                _keepalive_stop.set()
                break
            elif user_input == "/clear":
                messages = [{"role": "system", "content": SYSTEM_PROMPT}]
                print("대화 내용이 초기화되었습니다.")
                continue
            elif user_input == "/light":
                one_shot_heavy = False
                persistent_heavy = False
                auto_heavy = False
                max_tokens = LIGHT_MAX_TOKENS
                print("light 모드")
                continue
            elif user_input == "/heavy":
                one_shot_heavy = True
                auto_heavy = False
                print("다음 질문만 heavy (1회성)")
                continue
            elif user_input == "/heavy on":
                one_shot_heavy = False
                persistent_heavy = True
                auto_heavy = False
                max_tokens = HEAVY_MAX_TOKENS
                print("heavy 모드 (고정) — /light 로 복귀")
                continue
            elif user_input == "/help":
                show_help()
                continue

        # decide tokens: explicit > auto-detect > default
        if one_shot_heavy or persistent_heavy:
            max_tokens = HEAVY_MAX_TOKENS
        else:
            is_heavy, reason = _classify_query(user_input)
            if is_heavy:
                auto_heavy = True
                max_tokens = HEAVY_MAX_TOKENS
                if reason:
                    print(f"  → 자동 heavy 감지 ({reason})")
            else:
                max_tokens = LIGHT_MAX_TOKENS

        messages.append({"role": "user", "content": user_input})
        reply = stream_chat(messages, max_tokens)
        if reply:
            messages.append({"role": "assistant", "content": reply})

        if one_shot_heavy:
            one_shot_heavy = False
        if auto_heavy:
            auto_heavy = False


if __name__ == "__main__":
    main()
