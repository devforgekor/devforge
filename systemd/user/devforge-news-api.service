[Unit]
Description=DevForge News Read API (표시용: Vercel fetch용 읽기 전용)
After=network-online.target postgres.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3.12 /opt/workspace/minihome/apps/news/news_api.py --port 8091
WorkingDirectory=/opt/workspace/minihome/apps/news
Restart=on-failure
RestartSec=5
Environment=HOME=/home/opc
Environment=PYTHONPATH=/opt/projects/server/scripts:/opt/workspace/minihome/apps/news
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
