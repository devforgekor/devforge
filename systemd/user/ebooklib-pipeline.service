# /home/opc/.config/systemd/user/ebooklib-pipeline.service
[Unit]
# [WHY] RestartSec>=10 이면 기본 StartLimitIntervalSec(10s) 윈도우가 채워지지 않아
#       start limit이 영영 trip되지 않고 auto-restart 루프가 무한 지속된다
#       (2026-10-03 devforge-mcp 4시간 1141회 재시도, watchdog 무감지).
#       systemd.unit(5) 참조.
StartLimitIntervalSec=60
Description=Ebook Pipeline — 파이프라인 루프 (devforge-watchdog 감시)
After=network-online.target svc-pod.service container-flaresolverr.service
Wants=network-online.target

[Service]
Type=notify
# [WHY] Vercel 프로젝트 일시정지(503)로 구 기본값이 죽어 있었다.
#       자체 호스팅 수신부로 다시 지향한다.
Environment=VERCEL_REVALIDATE_URL=https://minihome4u.duckdns.org/miniebook/api/revalidate
Environment=PYTHONPATH=/opt/workspace/minihome/apps/ebooklib/apps/backend
WorkingDirectory=/opt/workspace/minihome/apps/ebooklib
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /opt/workspace/minihome/apps/ebooklib/apps/backend/venv/bin/python3 /opt/workspace/minihome/apps/ebooklib/scripts/pipeline.py loop --keys DATAIMPULSE-*,VERCEL-*,BRAVE-*
WatchdogSec=1800
Restart=on-watchdog
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
