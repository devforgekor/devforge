[Unit]
Description=Gemini OpenAI-Compatible Key-Rotation Proxy
After=default.target

[Service]
Type=simple
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3.11 /opt/projects/server/scripts/proxies/gemini_openai.py
Restart=on-failure
Environment=PYTHONPATH=/opt/projects/server/scripts
WorkingDirectory=/opt/projects/server/scripts
RestartSec=5

[Install]
WantedBy=default.target
