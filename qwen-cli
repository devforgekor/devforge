#!/usr/bin/env python3
"""Qwen CLI — chat with the local Qwen 2.5 Coder model via llama.cpp API."""

import json
import os
import readline
import sys
import threading
import time

import requests

ENDPOINT = os.environ.get("QWEN_API_URL", "http://127.0.0.1:8080/v1")
API_KEY = os.environ.get("QWEN_API_KEY", "unused")
MODEL = os.environ.get(
    "QWEN_MODEL", "qwen2.5-coder-7b-instruct-q8_0.gguf"
)
SYSTEM_PROMPT = (
    "You are a helpful assistant. Always respond in Korean (한국어). "
    "Keep answers concise and practical."
)

LIGHT_MAX_TOKENS = 512
HEAVY_MAX_TOKENS = 4096

HEAVY_KEYWORDS = [
    "코드", "작성", "구현", "만들어", "생성", "알려줘",
    "함수", "클래스", "모듈", "라이브러리", "예제", "예시",
    "설명", "문서", "가이드", "튜토리얼", "비교",
    "디버그", "에러", "버그", "해결", "고쳐",
    "리팩토링", "설계", "아키텍처", "패턴", "원리",
    "분석", "리뷰", "검토", "최적화",
    "code", "write", "implement", "create", "explain",
    "function", "class", "example", "fix", "debug",
    "파이썬", "자바", "자바스크립트", "python", "javascript",
    "sql", "쿼리", "api", "docker", "git",
]

LIGHT_KEYWORDS = [
    "뭐야", "뭐", "누구", "언제", "어디", "왜", "어때",
    "안녕", "고마워", "ㅇㅋ", "ㅇㅇ", "응", "그래",
    "짧게", "간단히", "한마디", "요약",
]

HEAVY_MIN_LENGTH = 80  # questions longer than this are likely heavy


def _classify_query(text: str) -> tuple[bool, str]:
    """Return (is_heavy, reason) for the query."""
    lower = text.lower()

    # explicit light keywords — respect it
    for kw in LIGHT_KEYWORDS:
        if kw in lower:
            return False, ""

    # explicit heavy keywords
    for kw in HEAVY_KEYWORDS:
        if kw in lower:
            return True, f"키워드: {kw}"

    # long questions usually need detailed answers
    if len(text) > HEAVY_MIN_LENGTH:
        return True, f"길이: {len(text)}자"

    return False, ""


HISTFILE = os.path.expanduser("~/.qwen_history")
CMDS = {"/exit", "/quit", "/clear", "/help", "/light", "/heavy", "/heavy on"}


def load_history() -> None:
    try:
        readline.read_history_file(HISTFILE)
    except FileNotFoundError:
        pass


def save_history() -> None:
    try:
        readline.write_history_file(HISTFILE)
    except OSError:
        pass


def stream_chat(messages: list[dict], max_tokens: int) -> str:
    """Send chat request and stream the response token by token."""
    payload = {
        "model": MODEL,
        "messages": messages,
        "stream": True,
        "temperature": 0.7,
        "max_tokens": max_tokens,
        "cache_prompt": True,
    }
    try:
        resp = requests.post(
            f"{ENDPOINT}/chat/completions",
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {API_KEY}",
            },
            json=payload,
            stream=True,
            timeout=120,
        )
        resp.raise_for_status()

        content_parts: list[str] = []
        for line in resp.iter_lines():
            if not line:
                continue
            data_str = line[6:]  # strip "data: " prefix (bytes)
            if data_str == b"[DONE]":
                break
            try:
                data = json.loads(data_str)
                delta = data["choices"][0].get("delta", {})
                token = delta.get("content", "")
                if token:
                    sys.stdout.write(token)
                    sys.stdout.flush()
                    content_parts.append(token)
            except (json.JSONDecodeError, KeyError, IndexError):
                continue
        print()
        return "".join(content_parts)
    except requests.ConnectionError:
        print("\n[오류] Qwen API에 연결할 수 없습니다. 서버가 실행 중인지 확인하세요.")
        return ""
    except requests.Timeout:
        print("\n[오류] 요청 시간이 초과되었습니다.")
        return ""
    except Exception as e:
        print(f"\n[오류] {e}")
        return ""


HEARTBEAT_INTERVAL = int(os.environ.get("QWEN_HEARTBEAT", "60"))

_keepalive_stop = threading.Event()


def _check_health() -> bool:
    try:
        return requests.get(f"{ENDPOINT}/health", timeout=5).ok
    except Exception:
        return False


def _warmup_cache() -> None:
    """Send system prompt through the model to prime the KV cache."""
    payload = {
        "model": MODEL,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": "hi"},
        ],
        "stream": False,
        "max_tokens": 4,
        "temperature": 0.0,
        "cache_prompt": True,
    }
    try:
        requests.post(
            f"{ENDPOINT}/chat/completions",
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {API_KEY}",
            },
            json=payload,
            timeout=15,
        )
    except Exception:
        pass


def _keepalive_loop() -> None:
    """Monitor /health. When server comes back up after a restart, re-warm cache."""
    was_alive = True  # assume alive at start (initial warmup handles the first prime)
    while not _keepalive_stop.is_set():
        _keepalive_stop.wait(HEARTBEAT_INTERVAL)
        if _keepalive_stop.is_set():
            break
        is_alive = _check_health()
        if is_alive and not was_alive:
            _warmup_cache()
        was_alive = is_alive


SPLASH = r"""
  ██████╗ ██╗    ██╗███████╗███╗   ██╗
 ██╔═══██╗██║    ██║██╔════╝████╗  ██║
