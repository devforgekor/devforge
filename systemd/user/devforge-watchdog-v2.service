[Unit]
# [WHY] RestartSec>=10 이면 기본 StartLimitIntervalSec(10s) 윈도우가 채워지지 않아
#       start limit이 영영 trip되지 않고 auto-restart 루프가 무한 지속된다
#       (2026-10-03 devforge-mcp 4시간 1141회 재시도, watchdog 무감지).
#       systemd.unit(5) 참조.
StartLimitIntervalSec=60
Description=DevForge Watchdog v2.1 (hexagonal)
After=container-postgres.service
Wants=container-postgres.service
OnFailure=devforge-watchdog-v2-failed.service

[Service]
Type=notify
NotifyAccess=main
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ai_data/scripts
Environment=PYTHONPATH=/opt/projects/server/src:/opt/projects/server/scripts
Environment=WATCHDOG_DRY_RUN=0
Environment=WATCHDOG_STATE_FILE=/opt/ai_data/scripts/watchdog_state.v2.json
Environment=WATCHDOG_CHECK_INTERVAL_SEC=60
Environment=WATCHDOG_ROUTING_ENABLED=1
Environment=WATCHDOG_ROUTING_CANARY=svc:svc-pod-forwarding
Environment=WATCHDOG_CATCHUP_ENABLED=1
Environment=WATCHDOG_CATCHUP_CANARY=timer:devforge-system-sync.timer
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3.12 -m devforge.cli watchdog serve --keys DEVFORGE-DATABASE-URL,DEVFORGE-POSTGRES-PASSWORD,SLACK-ENV-CONFIG,TELEGRAM-ALERT-TOKEN-KEY,TELEGRAM-CHAT-ID
WatchdogSec=180
Restart=on-watchdog
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
