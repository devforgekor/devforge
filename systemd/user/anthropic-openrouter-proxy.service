[Unit]
Description=Anthropic→OpenRouter Format Conversion Proxy (Paid Key)
Documentation=https://openrouter.ai/docs
After=network.target

[Service]
Type=simple
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3 -u /opt/projects/server/scripts/proxies/anthropic_openrouter.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
