[Unit]
Description=DevForge OpenRouter Free Model Refresh (매일 00:30 KST = 15:30 UTC)

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/projects/server/scripts
ExecStart=/usr/bin/python3.12 /opt/projects/server/scripts/proxies/refresh_openrouter_free_models.py
# [WHY] rerank 롤은 /rerank live-test에 sk-or 키가 필요 → KV 주입 래퍼 경유 (openrouter-rr-proxy와 동일 패턴)
ExecStart=/usr/bin/python3.12 /opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3.12 /opt/projects/server/scripts/proxies/refresh_openrouter_free_models.py --role rerank --keys OPENROUTER-*
ExecStart=/usr/bin/python3.12 /opt/projects/server/scripts/proxies/refresh_openrouter_free_models.py --role reasoning
WorkingDirectory=/opt/projects/server/scripts
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target