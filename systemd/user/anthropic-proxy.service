[Unit]
Description=Anthropic-Compatible Reverse Proxy for DeepSeek
Documentation=https://github.com/deepseek-ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/projects/server/scripts/deploy/kv-fetch-env.py /usr/bin/python3 /opt/projects/server/scripts/proxies/anthropic.py --keys DEEPSEEK-*
WorkingDirectory=/opt/projects/server/scripts
Restart=always
Environment=PYTHONPATH=/opt/projects/server/scripts
RestartSec=5
StandardOutput=journal
StandardError=journal

Environment=ANTHROPIC_PROXY_STREAM_TIMEOUT=300
Environment=ANTHROPIC_PROXY_SORT_KEYS=1
Environment=ANTHROPIC_PROXY_COMPACT_JSON=1
Environment=ANTHROPIC_PROXY_CONTEXT_WINDOW=256000
Environment=ANTHROPIC_PROXY_INSURANCE_TRIGGER=921600

; Environment variables (can be overridden via drop-in)
; ANTHROPIC_PROXY_LISTEN=127.0.0.1:44777
; ANTHROPIC_PROXY_UPSTREAM=https://api.deepseek.com/anthropic

[Install]
WantedBy=default.target
