[Unit]
Description=DevForge Dev Poll — auto-safe issue claim

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/projects/server/scripts/cli.py dev poll --auto-safe --claim --once
ExecStartPost=-/opt/projects/server/scripts/deploy/heartbeat-ping.sh dev_poll
WorkingDirectory=/opt/projects/server/scripts
StandardOutput=journal
StandardError=journal
